{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VVgbon916/Avalhla_Characters/schema/crossworld-record.schema.json",
  "title": "Avalhla CrossWorld Canonical Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_type", "concept_id", "canonical_name", "scope", "status", "description"],
  "properties": {
    "record_type": {
      "type": "string",
      "enum": ["PRESENCE", "ASPECT", "BOND", "WORLD", "DOOR", "CROSSING", "SKILL", "CRAFT", "OBJECT", "COLOR"]
    },
    "concept_id": {
      "type": "string",
      "pattern": "^cw:[a-z0-9][a-z0-9._-]*$"
    },
    "canonical_name": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["CANONICAL", "TARGET", "LEGACY", "DERIVED"]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "default": []
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["predicate", "target_concept_id"],
        "properties": {
          "predicate": {"type": "string", "minLength": 1},
          "target_concept_id": {
            "type": "string",
            "pattern": "^cw:[a-z0-9][a-z0-9._-]*$"
          }
        }
      },
      "default": []
    },
    "attributes": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "value"],
        "properties": {
          "language": {"type": "string", "minLength": 1},
          "value": {"type": "object", "additionalProperties": true}
        }
      },
      "default": []
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "source_type"],
      "properties": {
        "source_ref": {"type": "string", "minLength": 1},
        "source_type": {
          "type": "string",
          "enum": ["HUMAN_DESIGN", "REPOSITORY", "EXTERNAL_SOURCE", "MIGRATION", "DERIVED"]
        },
        "note": {"type": "string"},
        "source_sha256": {
          "type": ["string", "null"],
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "record_sha256": {
          "type": ["string", "null"],
          "pattern": "^[A-Fa-f0-9]{64}$"
        }
      }
    }
  }
}
